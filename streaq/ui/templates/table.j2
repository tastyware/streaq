<table class="table table-sm table-striped table-hover" id="tasks">
  <thead>
    <tr>
      <th scope="col">Updated time</th>
      <th scope="col">Function name</th>
      <th scope="col">Status</th>
      <th scope="col">Task ID</th>
      {% if is_dead or is_abortable %}
      <th scope="col" style="width: 5%"></th>
      {% endif %}
    </tr>
  </thead>
  <tbody class="font-monospace">
    {% for task in tasks %}
    <tr>
      <td>{{ task.enqueue_time }}</td>
      <td>{{ task.fn_name }}</td>
      <td><span class="badge bg-{{ task.color }} text-uppercase text-{{ task.text_color }}">{{ task.status.value
          }}</span></td>
      <td><a href="{{ task.url }}">{{ task.task_id }}</a></td>
      {% if is_dead or is_abortable %}
      <td class="text-nowrap">
        {% if is_dead %}
        <div class="d-inline" hx-post="{{ base_url }}task/{{ task.task_id }}/requeue?redirect=false"
          hx-target="closest tr" hx-swap="delete" title="Requeue Task">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"
            role="button" class="text-primary" style="cursor: pointer">
            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
            <path
              d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
          </svg>
          <img class="htmx-indicator" src="https://www.tastyware.dev/static/bars.svg" width="16" height="16" />
        </div>
        {% endif %}
        <div class="d-inline"
          hx-delete="{{ base_url }}task/{{ task.task_id }}{{ '/purge' if is_dead else '' }}?redirect=false"
          hx-confirm="{{ 'Purge' if is_dead else 'Abort' }} {{ task.task_id }}?" hx-target="closest tr" hx-swap="delete"
          title="{{ 'Purge' if is_dead else 'Abort' }} Task">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"
            role="button" class="text-danger" style="cursor: pointer">
            <path
              d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
            <path
              d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
          </svg>
          <img class="htmx-indicator" src="https://www.tastyware.dev/static/bars.svg" width="16" height="16" />
        </div>
      </td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>
