{% extends "base.j2" %}

{% block queue %}active{% endblock %}

{% block content %}
<style>
  .htmx-request>svg {
    display: none;
  }

  /* while filtering, swap the task table for the bars */
  #tasks-spinner {
    display: none;
  }

  #tasks-wrap.htmx-request #tasks {
    display: none;
  }

  #tasks-wrap.htmx-request #tasks-spinner {
    display: block;
  }
</style>
{% macro card(title, count, classes) %}
<div class="col">
  <div class="card shadow {{ classes }}">
    <div class="card-body d-flex align-items-center justify-content-between">
      <div>
        <h6 class="card-title">{{ title }}</h6>
        <h5 class="card-subtitle mb-0">{{ count | humanize }}</h5>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
        {{ caller() }}
      </svg>
    </div>
  </div>
</div>
{% endmacro %}
<div class="container">
  <div class="row mb-3 mt-3">
    {% call card("SCHEDULED", scheduled, "text-white bg-secondary") %}
    <path
      d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857z" />
    <path
      d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2" />
    {% endcall %}
    {% call card("DEPENDS", depends, "text-dark bg-light") %}
    <path
      d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z" />
    <path
      d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z" />
    {% endcall %}
    {% call card("QUEUED", queued, "text-dark bg-info") %}
    <path
      d="m14.12 10.163 1.715.858c.22.11.22.424 0 .534L8.267 15.34a.6.6 0 0 1-.534 0L.165 11.555a.299.299 0 0 1 0-.534l1.716-.858 5.317 2.659c.505.252 1.1.252 1.604 0l5.317-2.66zM7.733.063a.6.6 0 0 1 .534 0l7.568 3.784a.3.3 0 0 1 0 .535L8.267 8.165a.6.6 0 0 1-.534 0L.165 4.382a.299.299 0 0 1 0-.535z" />
    <path
      d="m14.12 6.576 1.715.858c.22.11.22.424 0 .534l-7.568 3.784a.6.6 0 0 1-.534 0L.165 7.968a.299.299 0 0 1 0-.534l1.716-.858 5.317 2.659c.505.252 1.1.252 1.604 0z" />
    {% endcall %}
    {% call card("RUNNING", running, "text-dark bg-warning") %}
    <path
      d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41m-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9" />
    <path fill-rule="evenodd"
      d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5 5 0 0 0 8 3M3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9z" />
    {% endcall %}
    {% call card("DONE", done, "text-white bg-success") %}
    <path
      d="M3 14.5A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5h8a.5.5 0 0 1 0 1H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5V8a.5.5 0 0 1 1 0v5a1.5 1.5 0 0 1-1.5 1.5z" />
    <path d="m8.354 10.354 7-7a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0" />
    {% endcall %}
    {% if dlq %}
    {% call card("DEAD", dead, "text-white bg-dark") %}
    <path
      d="M4.54.146A.5.5 0 0 1 4.893 0h6.214a.5.5 0 0 1 .353.146l4.394 4.394a.5.5 0 0 1 .146.353v6.214a.5.5 0 0 1-.146.353l-4.394 4.394a.5.5 0 0 1-.353.146H4.893a.5.5 0 0 1-.353-.146L.146 11.46A.5.5 0 0 1 0 11.107V4.893a.5.5 0 0 1 .146-.353zM5.1 1 1 5.1v5.8L5.1 15h5.8l4.1-4.1V5.1L10.9 1z" />
    <path
      d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
    {% endcall %}
    {% endif %}
  </div>
  <div class="row mb-3">
    <div class="col-12">
      <div class="card shadow">
        <div class="card-body">
          <form hx-patch="{{ base_url }}queue" hx-trigger="change" hx-target="#tasks" hx-swap="outerHTML"
            hx-indicator="#tasks-wrap">
            <div class="row mb-3" style="max-height: 100%">
              <div class="col-6">
                <h3 class="card-title">Tasks</h3>
              </div>
              <div class="col-2">
                <label for="function">Function</label>
                <select name="functions" class="form-select" multiple id="function">
                  {% for fn in functions %}
                  <option value="{{ fn }}">{{ fn }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-2">
                <label for="status">Priority</label>
                <select name="priority" class="form-select" id="priority">
                  <option value="default">default</option>
                </select>
              </div>
              <div class="col-2">
                <label for="status">Status</label>
                <select name="status" class="form-select" id="status">
                  <option value="depends">DEPENDS</option>
                  <option value="scheduled">SCHEDULED</option>
                  <option value="queued">QUEUED</option>
                  <option value="running">RUNNING</option>
                  <option selected value="done">DONE</option>
                  {% if dlq %}
                  <option value="dead">DEAD</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </form>
          <div id="tasks-wrap">
            {% include "table.j2" %}
            <img id="tasks-spinner" class="htmx-indicator mx-auto my-5" src="https://www.tastyware.dev/static/bars.svg"
              height="48" />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
